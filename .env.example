# Copy to .env (repo root) and fill in. Never commit .env.
# The backend reads it via pydantic-settings; docker-compose passes it to the api service.

# Google Gemini API key (https://aistudio.google.com/apikey).
# On the free tier Google may use prompts to improve its products:
# do not send copyrighted rulebook text through a free-tier key.
GOOGLE_API_KEY=your-api-key

# Client-side request cap for Gemini (requests per minute). Each player turn makes 2 calls.
# Free-tier quotas are low; raise this on a paid key.
GOOGLE_RPM=10

# Experiment arm used by the app (defined in src/backend/experiments/*.yaml).
DEFAULT_ARM=play-gemini

# Optional overrides. Use absolute paths; by default the databases live in src/backend/var/,
# scenarios in data/ and run logs in artifacts/ (both at the repo root).
# CHECKPOINT_PATH=C:/dev/gm-var/checkpoints.db
# APP_DB_PATH=C:/dev/gm-var/app.db
# DATA_DIR=C:/path/to/gm-assistant/data
# ARTIFACTS_DIR=C:/path/to/gm-assistant/artifacts
# RUNLOG_ENABLED=true
# LOG_LEVEL=INFO

# Frontend dev server: where Vite proxies /api (default http://localhost:8000).
# API_PROXY_TARGET=http://localhost:8000

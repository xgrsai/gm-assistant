# Copy to .env and fill in. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Note: on the free tier Google may use prompts to improve its products —
# do not send copyrighted rulebook text through a free-tier key.
GOOGLE_API_KEY=your-api-key

# Backend URL as seen from the browser. docker-compose passes it to the Vite
# frontend; for a local `npm run dev` it defaults to http://localhost:8000
# (override in src/frontend/.env.local if needed).
VITE_API_URL=http://localhost:8000

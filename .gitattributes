# Normalize line endings: LF in the repo and in checkouts.
# Prompt templates and corpus chunks get hashed for experiment reproducibility,
# so CRLF on Windows must not change their bytes.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.gguf binary
*.safetensors binary

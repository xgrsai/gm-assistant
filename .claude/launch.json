{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend (uvicorn)",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "src/backend", "uvicorn", "server.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend (vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "gold review page",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "src/backend", "python", "-m", "http.server", "8765", "--bind", "127.0.0.1",
                      "--directory", "../../artifacts/review"],
      "port": 8765
    }
  ]
}

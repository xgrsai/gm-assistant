{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(npm run *)",
      "Bash(npm ls *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
